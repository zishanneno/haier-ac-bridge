# Optional: direct Node.js installation. Docker settings are in compose.yaml.
HOST=127.0.0.1
PORT=8787
# DATA_DIR=./data
# An API token is generated automatically; set only to use your own (24+ characters).
# HAIER_API_TOKEN=replace-with-a-long-random-secret

# Optional unattended Haismart login. Prefer the browser wizard, which does not save your password.
# HAISMART_USERNAME=you@example.com
# HAISMART_PASSWORD=your-haismart-password
# HAISMART_ZONE=92

# Docker Compose: enable only on a trusted home network when accessing from another device.
# BRIDGE_BIND_ADDRESS=0.0.0.0
# BRIDGE_PORT=8787
